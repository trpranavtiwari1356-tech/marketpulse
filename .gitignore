# dependencies (none today — zero-dep — but future-proof)
node_modules/

# Runtime cache. Most of it is Yahoo-derived and regenerates anywhere, so it stays ignored.
# The exceptions below are all NSE-sourced: NSE blocks the cloud host's IP outright, so the
# deployed site can never fetch them itself. Git is therefore the transport — the local machine
# (whose IP NSE allows) refreshes these and commits them via `npm run refresh-data`.
# Everything committed here is public market data, no credentials.
.cache/*
!.cache/constituents.json
!.cache/equitymaster.json
!.cache/segfiled.json
!.cache/fiidii.json
!.cache/deals.json
!.cache/ecal.json
# Macro Maps. Not NSE-blocked, but the same argument applies for a different reason: the World
# Bank + IMF pull is ~800 KB per indicator and takes ~15s from a fast line, which is what used to
# time out and 502 on the free tier. Committing the built snapshots means a fresh deploy serves
# real macro data on its FIRST request instead of waiting on DBnomics, and the background sweep
# then keeps them current. ~1 MB total, all public reference data.
!.cache/macro_*.json
# Daily bhavcopy = delivery % + volume conviction. ~185 KB raw each, but git zlib-packs them to
# ~64 KB, and the refresh script prunes to the 30-day window the engine actually reads.
# Do NOT pre-gzip these — that defeats git's delta compression and makes history bigger.
!.cache/bhav_*.json

# local tooling / editor / preview config — not needed in production
.claude/
*.log
.DS_Store
Thumbs.db
